// SYNQUE — Prisma schema
// Social media team work management platform
// Database: PostgreSQL (works with PGlite locally, Neon in production)

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String?  // hashed password (null for invited users)
  avatar      String?
  role        String   @default("member") // admin | manager | editor | member | viewer
  title       String?  // designation e.g. "Head of Social"
  department  String?  // e.g. "Content", "Paid Social", "Community"
  color       String?  // accent gradient seed
  permissions String?  // JSON array of permission strings
  status      String   @default("active") // active | suspended | invited
  lastActive  DateTime?
  createdAt   DateTime @default(now())
  bio         String?  // short personal bio (max ~280 chars)
  timezone    String?  // IANA timezone e.g. "America/Los_Angeles"
  language    String?  // locale code e.g. "en-US"
  gender      String?  // male | female | other — for avatar fallback + birthday greetings
  birthDate   DateTime? // for birthday notifications + calendar
  phone       String?  // contact number
  // Multi-tenant: links this user to a Customer (tenant).
  // null = super-admin (sees all tenants). Set when a user is created
  // by a manager/admin who belongs to a specific client.
  customerId  String?
  // 2FA / Security
  emailVerified  DateTime?  // when the user verified their email
  totpSecret     String?    // TOTP secret for 2FA (base32 encoded)
  pendingTotpSecret String? // staged TOTP secret during 2FA setup — committed to totpSecret only after the user verifies a code from their authenticator
  twoFactorEnabled Boolean  @default(false) // whether 2FA is required on login
  // Sessions + login history
  sessions       Session[]

  accounts  Account[]
  posts     Post[]
  activities Activity[]
  assignedComments Comment[] @relation("CommentAssignee")
  mailboxes Mailbox[] @relation("MailboxOwner")
  workspace WorkspaceSettings?
  platformCredentials PlatformCredential[]
  savedWhatsAppMsgs   WhatsAppMessage[] @relation("WhatsAppSavedBy")
  sentMessages        ChatMessage[]     @relation("ChatSender")
  receivedMessages    ChatMessage[]     @relation("ChatReceiver")
  vpnSessions         VPNSession[]
  webauthnCredentials  WebAuthnCredential[]
}

model Account {
  id          String   @id @default(cuid())
  platform    String   // instagram | facebook | x | linkedin | tiktok | youtube | threads
  handle      String
  displayName String
  avatar      String?
  followers   Int      @default(0)
  postsCount  Int      @default(0)
  verified    Boolean  @default(false)
  ownerId     String
  // Multi-tenant: accounts are scoped to a customer (tenant)
  customerId  String?
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())

  variants   PostVariant[]
  analytics  AnalyticsDaily[]
  comments   Comment[]
  health     AccountHealth?
  protection AccountProtection?

  @@index([ownerId])
  @@index([customerId])
  @@index([platform])
}

// ===== Account Health (suspension risk + sentiment ratio) =====
model AccountHealth {
  id            String   @id @default(cuid())
  accountId     String   @unique
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // sentiment split of comments/mentions (last 30d)
  positiveCount Int      @default(0)
  neutralCount  Int      @default(0)
  negativeCount Int      @default(0)
  // reports / flags
  reportCount   Int      @default(0)
  reportTrend   Int      @default(0) // +/- change vs prev period
  // risk
  riskScore     Int      @default(0) // 0-100, higher = more at risk
  riskLevel     String   @default("safe") // safe | moderate | elevated | high | critical
  // status
  status        String   @default("healthy") // healthy | warning | restricted | suspended
  lastUpdated   DateTime @default(now())
  // reasons array (JSON string) — why risk is elevated
  riskReasons   String?  // JSON: ["spam_flagged","high_report_rate",...]
  updatedAt     DateTime @updatedAt
}

// ===== Account Protection (anti-suspension settings) =====
model AccountProtection {
  id                       String  @id @default(cuid())
  accountId                String  @unique
  account                  Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // posting cadence guards
  dailyPostLimit           Int     @default(4)
  hourlyPostLimit          Int     @default(2)
  minMinutesBetweenPosts   Int     @default(30)
  // content safety
  autoFlagSensitiveContent Boolean @default(true)
  blockDuplicateContent   Boolean @default(true)
  blockBannedHashtags     Boolean @default(true)
  bannedHashtags           String? // comma-separated custom banned list
  // behavior guards
  enforceWarmupProfile     Boolean @default(true)
  limitDMsPerHour          Int     @default(20)
  limitFollowsPerHour     Int     @default(15)
  limitCommentsPerHour     Int     @default(30)
  // automation pause
  pausePostingOnWarning   Boolean @default(true)
  cooldownHoursOnFlag     Int     @default(24)
  // two-factor / verified
  requireTwoFactor        Boolean @default(true)
  // status
  enabled                  Boolean @default(true)
  lastAudit                DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Post {
  id         String    @id @default(cuid())
  title      String
  caption    String    // shared base caption / brief
  mediaUrl   String?
  mediaType  String    @default("image") // image | video | carousel | none
  tone       String    @default("professional")
  status     String    @default("draft") // draft | scheduled | published | failed
  scheduledAt DateTime?
  authorId   String
  // Multi-tenant: posts are scoped to a customer (tenant)
  customerId String?
  author     User      @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  variants   PostVariant[]

  @@index([authorId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

model PostVariant {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  content     String    // AI-generated platform-specific content
  hashtags    String?   // comma separated
  status      String    @default("draft") // draft | scheduled | published | failed
  publishedAt DateTime?
  likes       Int       @default(0)
  comments    Int       @default(0)
  shares      Int       @default(0)
  reach       Int       @default(0)
  impressions Int       @default(0)
  saves       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([accountId])
  @@index([postId])
  @@index([status])
  @@index([publishedAt])
}

model Comment {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  author     String
  authorAvatar String?
  text       String
  type       String   @default("comment") // comment | message | mention
  sentiment  String   @default("neutral") // positive | neutral | negative
  replied    Boolean  @default(false)
  replyText  String?  // the team's reply (stored so it's not lost)
  assigneeId String?
  assignee   User?    @relation("CommentAssignee", fields: [assigneeId], references: [id])
  repliedAt  DateTime?
  // Multi-tenant: comments are scoped to a customer (tenant) via the owning
  // account. Denormalised here so list queries can be filtered directly
  // without a join. null = legacy / super-admin owned.
  customerId String?
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@index([replied])
  @@index([createdAt])
  @@index([sentiment])
}

model AnalyticsDaily {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  date       DateTime
  followers  Int
  impressions Int
  reach      Int
  engagement Float
  posts      Int

  @@index([accountId])
  @@index([date])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  // Multi-tenant: activities are scoped to a customer (tenant)
  customerId  String?
  type        String   // post_published | post_scheduled | comment_replied | account_connected | ai_generated | team_joined
  description String
  meta        String?  // JSON string for extra context
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([createdAt])
}

// ===== Campaigns =====
model Campaign {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String    @default("#E1306C")
  status      String    @default("active") // draft | active | paused | completed
  objective   String?   // awareness | engagement | conversion | traffic
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  // Multi-tenant: campaigns are scoped to a customer (tenant)
  customerId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ===== Media Library =====
model MediaAsset {
  id          String   @id @default(cuid())
  name        String
  type        String   // image | video | audio
  url         String
  thumbnail   String?
  size        Int      @default(0) // bytes
  width       Int?
  height      Int?
  tags        String?  // comma separated
  folder      String   @default("root")
  uploadedById String?
  // Multi-tenant: links this asset to a specific Customer (organisation).
  // null = belongs to super-admin (visible across tenants).
  customerId  String?
  createdAt   DateTime @default(now())
}

// ===== Social Listening / Brand Monitoring =====
model ListeningQuery {
  id         String   @id @default(cuid())
  name       String
  keywords   String   // comma separated
  type       String   @default("brand") // brand | competitor | keyword | hashtag
  color      String   @default("#E1306C")
  status     String   @default("active") // active | paused
  createdAt  DateTime @default(now())
  // Multi-tenant: links to Customer (null = super-admin)
  customerId String?

  mentions   Mention[]

  @@index([customerId])
}

model Mention {
  id         String   @id @default(cuid())
  queryId    String
  query      ListeningQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  source     String   // instagram | x | facebook | web | reddit | news
  author     String
  authorAvatar String?
  text       String
  url        String?
  sentiment  String   @default("neutral") // positive | neutral | negative
  reach      Int      @default(0)
  engagement Int      @default(0)
  date       DateTime
  createdAt  DateTime @default(now())

  @@index([queryId])
  @@index([date])
}

// ===== Approval Workflows =====
model Approval {
  id           String   @id @default(cuid())
  postId       String?
  title        String
  authorId     String
  approverId   String?
  status       String   @default("pending") // pending | approved | rejected | changes_requested
  comment      String?
  priority     String   @default("normal") // low | normal | high | urgent
  dueAt        DateTime?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
}

// ===== Tasks (admin workflow) =====
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  // Rich content for sending a task straight to the composer
  content     String?  // the actual post caption / body text the user wrote
  mediaUrl    String?  // attached media (image/video URL or data URL)
  mediaType   String?  // image | video | audio | null
  platforms   String?  // JSON array of platform ids the task should be published to
  tags        String?  // comma-separated tags/hashtags
  assigneeId  String?
  creatorId   String
  // Multi-tenant: tasks are scoped to a customer (tenant)
  customerId  String?
  status      String    @default("todo") // todo | in_progress | review | done | blocked
  priority    String    @default("normal") // low | normal | high | urgent
  type        String    @default("content") // content | review | engagement | analytics | campaign
  relatedPostId String?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([assigneeId])
  @@index([status])
  @@index([customerId])
  @@index([dueAt])
}

// ===== Hashtag Manager =====
model HashtagGroup {
  id         String   @id @default(cuid())
  name       String
  tags       String   // comma separated, no #
  platform   String   @default("all") // all | instagram | x | tiktok | linkedin
  usageCount Int      @default(0)
  avgReach   Int      @default(0)
  color      String   @default("#E1306C")
  createdAt  DateTime @default(now())
  // Multi-tenant: links to Customer (null = super-admin)
  customerId String?

  @@index([customerId])
}

// ===== Competitor Tracking =====
model Competitor {
  id         String   @id @default(cuid())
  name       String
  handle      String
  platform   String
  avatar     String?
  followers  Int      @default(0)
  engagementRate Float @default(0)
  growthRate Float    @default(0)
  postingFreq Float   @default(0) // posts/week
  status     String   @default("tracking") // tracking | paused
  notes      String?
  createdAt  DateTime @default(now())
  // Multi-tenant: links to Customer (null = super-admin)
  customerId String?

  snapshots  CompetitorSnapshot[]

  @@index([customerId])
}

model CompetitorSnapshot {
  id           String   @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  date         DateTime
  followers    Int
  engagement   Float
  posts        Int
}

// ===== Custom Reports =====
model Report {
  id          String   @id @default(cuid())
  name        String
  type       String   @default("performance") // performance | audience | campaign | competitor | custom
  description String?
  config      String   // JSON: { metrics, dateRange, accounts, groupBy }
  schedule    String?  // daily | weekly | monthly | null
  createdBy   String?
  // Multi-tenant: reports are scoped to a customer (tenant).
  // null = belongs to super-admin (visible across tenants).
  customerId  String?
  lastGenerated DateTime?
  createdAt   DateTime @default(now())
}

// ===== Link in Bio =====
model LinkInBio {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  avatar      String?
  theme       String   @default("rose") // rose | teal | amber | magenta | green | dark
  links       String   // JSON array: [{ title, url, icon }]
  visits      Int      @default(0)
  clicks     Int      @default(0)
  accountId   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  // Multi-tenant: links to Customer (null = super-admin)
  customerId  String?

  @@index([customerId])
}

// ===== WhatsApp Inbox (pasted from groups/chats) =====
model WhatsAppMessage {
  id          String   @id @default(cuid())
  source      String   @default("group") // group | chat | broadcast | channel
  senderName  String
  senderPhone String?  // E.164 format if available
  groupName   String?  // name of the group/chat it was pasted from
  content     String   // the pasted message text
  mediaUrl    String?  // attached image/video URL (if pasted)
  mediaType   String?  // image | video | audio | document
  status      String   @default("new") // new | used | archived
  // After the message is sent to the Composer + published, link it to the post:
  postId      String?
  // Who saved/pasted it:
  savedById   String?
  savedBy     User?    @relation("WhatsAppSavedBy", fields: [savedById], references: [id])
  // Auto-received from a live WhatsApp connection (vs. manually pasted)?
  isLive      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ===== WhatsApp Connection (per-workspace QR-scan session) =====
model WhatsAppConnection {
  id          String   @id @default(cuid())
  // Single row per workspace (keyed by a fixed ownerId)
  ownerId     String   @unique
  phone       String?  // E.164 of the connected WhatsApp number
  status      String   @default("disconnected") // disconnected | connecting | connected
  // We don't store the QR code itself (it rotates) — the mini-service holds it in memory
  lastConnectedAt DateTime?
  lastDisconnectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Team Chat (internal messaging) =====
model ChatMessage {
  id        String   @id @default(cuid())
  senderId  String
  sender    User    @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String? // null = group message (broadcast to all team members)
  receiver  User?   @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  text      String
  fileUrl   String? // attached file URL (image, doc, etc.)
  fileName  String? // original file name
  fileType  String? // image | video | document | audio
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([isRead])
}

// ===== Mail Server =====
model MailServer {
  id           String   @id @default(cuid())
  name         String
  provider     String   @default("custom") // custom | hostinger | cpanel | zoho | mailgun | other
  domain       String
  imapHost     String
  imapPort     Int      @default(993)
  imapSecure   Boolean  @default(true)
  smtpHost     String
  smtpPort     Int      @default(465)
  smtpSecure   Boolean  @default(true)
  username     String   // admin/ catch-all account
  passwordEnc  String   // stored (mock-encrypted)
  fromName     String
  fromEmail    String
  status       String   @default("pending") // pending | connected | error
  lastCheck    DateTime?
  createdAt    DateTime @default(now())
  // Multi-tenant: null for super-admin (sees all)
  customerId   String?
  mailboxes    Mailbox[]

  @@index([customerId])
}

model Mailbox {
  id           String   @id @default(cuid())
  serverId     String
  server       MailServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  email        String   @unique
  displayName  String
  passwordEnc  String   // stored (mock-encrypted)
  quotaMb      Int      @default(2048)
  usedMb       Float    @default(0)
  ownerId      String?  // assigned team member
  owner        User?    @relation("MailboxOwner", fields: [ownerId], references: [id])
  status       String   @default("active") // active | suspended | creating
  role         String   @default("member") // admin | member
  createdAt    DateTime @default(now())
  // Multi-tenant: denormalized from MailServer.customerId for fast scoping.
  // null for super-admin (sees all)
  customerId   String?
  messages     MailMessage[]

  @@index([customerId])
}

model MailMessage {
  id          String   @id @default(cuid())
  mailboxId   String
  mailbox     Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  fromAddr    String
  toAddr      String
  subject     String
  body        String
  direction   String   @default("in") // in | out
  folder      String   @default("inbox") // inbox | sent | drafts | trash | starred
  isRead      Boolean  @default(false)
  isStarred   Boolean  @default(false)
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([mailboxId])
  @@index([folder])
  @@index([date])
}

// ===== Owner Module: Customers, Invoices, Quotations, Serial Keys =====
model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  company     String?
  address     String?
  city        String?
  country     String?
  status      String   @default("active") // active | suspended | trial
  plan        String   @default("starter") // starter | growth | enterprise
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serialKey   SerialKey?
  invoices      Invoice[]
  quotations    Quotation[]
  subscriptions Subscription[]
}

model SerialKey {
  id          String    @id @default(cuid())
  key         String    @unique
  customerId  String?   @unique
  deviceName  String?
  deviceFingerprint String?
  status      String    @default("unused") // unused | activated | revoked
  activatedAt DateTime?
  createdAt   DateTime  @default(now())

  customer    Customer? @relation(fields: [customerId], references: [id])
  device      Device?
}

model Invoice {
  id              String   @id @default(cuid())
  number          String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status          String   @default("draft") // draft | sent | paid | overdue
  issueDate       DateTime @default(now())
  dueDate         DateTime?
  subtotal        Float    @default(0)
  discountType    String?  // "percentage" | "fixed"
  discountValue   Float?   // percentage or fixed amount
  discountAmount   Float    @default(0) // computed discount amount
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0)
  notes           String?
  items           String   // JSON array: [{description, qty, price, amount}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
}

model Quotation {
  id              String   @id @default(cuid())
  number          String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status          String   @default("draft") // draft | sent | accepted | rejected
  issueDate       DateTime @default(now())
  validUntil      DateTime?
  subtotal        Float    @default(0)
  discountType    String?  // "percentage" | "fixed"
  discountValue   Float?   // percentage or fixed amount
  discountAmount   Float    @default(0) // computed discount amount
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0)
  notes           String?
  items           String   // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
}

model BankAccount {
  id          String   @id @default(cuid())
  accountName String
  bankName    String
  accountNumber String
  iban        String?
  swift       String?
  currency    String   @default("USD")
  isDefault   Boolean  @default(false)
  // Multi-tenant: bank accounts are scoped to a customer (tenant).
  // null = belongs to super-admin (visible across tenants).
  customerId  String?
  createdAt   DateTime @default(now())
}

// ===== API Keys =====
model ApiKey {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  permissions String   @default("[]") // JSON array
  status      String   @default("active") // active | revoked
  lastUsed    DateTime?
  createdAt   DateTime @default(now())
}

// ===== Device Management =====
model Device {
  id          String   @id @default(cuid())
  serialKeyId String?  @unique
  deviceName  String
  fingerprint String?  @unique
  ipAddress   String?
  location    String?
  status      String   @default("active") // active | blocked | revoked
  lastSeen    DateTime?
  createdAt   DateTime @default(now())

  serialKey   SerialKey? @relation(fields: [serialKeyId], references: [id])
}

// ===== Subscription =====
model Subscription {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan            String   @default("growth") // starter | growth | enterprise | custom
  status          String   @default("trial") // trial | active | cancelled | expired
  startDate       DateTime @default(now())
  endDate         DateTime?
  trialEnds       DateTime?
  amount          Float    @default(0)
  currency        String   @default("USD")
  discountType    String?  // "percentage" | "fixed" | null
  discountValue   Float?   // the percentage or fixed amount
  discountAmount   Float?   // computed discount amount
  taxRate         Float?   // tax percentage (e.g. 10 = 10%)
  taxAmount       Float?   // computed tax amount
  totalAmount     Float?   // amount - discount + tax
  billingCycle    String?  // "monthly" | "quarterly" | "yearly"
  notes           String?  // admin notes
  createdAt       DateTime @default(now())

  @@index([customerId])
}

// ===== Workspace Settings (one row per workspace, keyed by owner) =====
model WorkspaceSettings {
  id          String   @id @default(cuid())
  name        String   @default("My Workspace")
  timezone    String   @default("America/Los_Angeles")
  cadence     String   @default("3/day")
  startTime   String   @default("09:00")
  endTime     String   @default("18:00")
  autoVariants Boolean  @default(true)
  tone        String   @default("Confident")
  brandVoice  String?
  colors      String?  // JSON array of brand color hex strings
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Platform API Credentials (real API keys for posting + sync) =====
model PlatformCredential {
  id            String   @id @default(cuid())
  userId        String   // owner
  platform      String   // twitter | instagram | linkedin | facebook | tiktok
  // OAuth App credentials (one-time setup by the platform owner):
  clientId      String?  // OAuth App ID / Consumer Key
  clientSecret  String?  // OAuth App Secret / Consumer Secret
  // For platforms that need it:
  redirectUri   String?  // OAuth redirect URI (usually https://yourdomain.com/api/oauth/callback/{platform})
  // Twitter API v2 (OAuth 2.0 or OAuth 1.0a):
  apiKey        String?  // Consumer Key (Twitter) / App ID (Instagram)
  apiSecret     String?  // Consumer Secret / App Secret
  accessToken   String?  // OAuth 2.0 access token (with tweet.write scope)
  accessSecret  String?  // OAuth 1.0a access token secret (Twitter only)
  bearerToken   String?  // App-only Bearer Token (Twitter)
  // Instagram/Facebook Graph API:
  pageId        String?  // IG Business Account ID or FB Page ID
  // LinkedIn:
  profileId     String?  // LinkedIn URN (urn:li:person:xxx)
  // Common:
  connected     Boolean  @default(false)
  // OAuth 2.0 user-context token (from "Login with X" flow — separate from OAuth 1.0a)
  oauth2UserToken String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}


model Integration {
  id          String   @id @default(cuid())
  type        String   @unique // mail | slack | stripe | ga | canva | unsplash | zapier
  name        String
  credentials String   // JSON: encrypted API keys, tokens, webhook URLs, etc.
  // Multi-tenant: binds this integration row to a specific Customer (tenant).
  // null = global/shared (e.g. super-admin configured, or pre-migration rows
  // that haven't been re-saved by a tenant admin yet).
  // NOTE: `type` is still @unique — there is at most ONE row per integration
  // type globally until a follow-up task relaxes this to
  // @@unique([customerId, type]). The `customerId` column lets GET queries
  // scope by tenant today (super-admin sees all, tenant users see only rows
  // they own).
  customerId  String?
  enabled     Boolean  @default(false)
  connectedAt DateTime?
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

// ===== Per-client database tracking =====
model TenantDatabase {
  id          String   @id @default(cuid())
  customerId  String   @unique
  dbName      String   @unique
  dbUrl       String
  status      String   @default("active")
  createdAt   DateTime @default(now())
}

// ===== Workspace (per-user personal workspace) =====
model Workspace {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  customerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shares      WorkspaceShare[]
}

// ===== Workspace sharing =====
model WorkspaceShare {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sharedWithUserId String
  sharedByUserId   String
  permission      String   @default("view")
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  acceptedAt      DateTime?

  @@unique([workspaceId, sharedWithUserId])
}

// ===== Organization directories (managed by admin/manager) =====
// These three models act as the tenant-scoped "directory" of available
// roles / departments / designations. The User table still stores the
// chosen value as a plain string for backward compatibility — these
// tables power the management UI (add / edit / delete options) and
// feed the dropdowns in the Add/Edit Member dialogs.

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  level       Int      @default(2) // 1=viewer ... 5=admin (informational)
  isSystem    Boolean  @default(false) // true for the 5 built-in roles — cannot be deleted
  customerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, customerId])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  // optional accent for tags / charts
  headUserId  String?  // optional head of department (User.id)
  customerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, customerId])
}

model Designation {
  id          String   @id @default(cuid())
  name        String
  description String?
  level       Int      @default(1) // junior / mid / senior / lead etc. (informational)
  customerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, customerId])
}

// ===== Session Tracking (login history + active sessions) =====
model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique // JWT token (for revocation)
  userAgent   String?  // browser + OS
  ipAddress   String?  // last known IP
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime? // null = active, set when user logs out / revokes

  @@index([userId])
}

// ===== Password Reset Tokens (DB-backed, not in-memory) =====
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   // user email
  token     String   @unique // the reset token
  expiresAt DateTime // when the token expires (typically 1 hour)
  usedAt    DateTime? // when the token was used (null = not used)
  createdAt DateTime @default(now())

  @@index([email])
}

// ===== Email Verification Tokens =====
model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

// ===== Influencer Tracker =====
// Track influencer partnerships — competitors like Hootsuite/Sprout offer
// this as a creator-management module. Each row = one creator relationship.
model Influencer {
  id              String   @id @default(cuid())
  name            String
  handle          String
  platform        String   // instagram | tiktok | youtube | x | linkedin | threads
  followers       Int      @default(0)
  engagementRate  Float    @default(0)   // % e.g. 3.5 = 3.5%
  cost            Float    @default(0)   // cost per post/campaign (currency-agnostic)
  estimatedReach  Int      @default(0)   // est. reach delivered
  estimatedEngagement Int  @default(0)   // est. likes+comments+shares earned
  status          String   @default("active") // active | paused | completed | draft
  campaignId      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Multi-tenant: links to Customer (null = super-admin)
  customerId      String?

  @@index([customerId])
}

// ===== VPN (WireGuard) =====
// Real WireGuard VPN server endpoints. Admin-configured — each row points
// to an actual running WireGuard server (the server's public key + host:port).
// The web app generates REAL client key pairs (x25519) and builds valid
// .conf files the user imports into the official WireGuard client.
model VPNServer {
  id            String   @id @default(cuid())
  countryCode   String                      // ISO 2-letter e.g. "US"
  countryName   String
  city          String
  flag          String   @default("🏳")     // emoji flag
  endpoint      String                      // host:port of the real WireGuard server
  serverPubKey  String                      // server's Curve25519 public key (base64)
  allowedIps    String   @default("0.0.0.0/0, ::/0")
  dns           String   @default("1.1.1.1, 1.0.0.1")
  addressPool   String   @default("10.66.0.0/24")  // client address pool (CIDR)
  ping          Int      @default(0)        // est. latency ms (informational)
  load          Int      @default(0)         // 0-100 server load %
  premium       Boolean  @default(false)
  status        String   @default("active")  // active | maintenance | offline
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions     VPNSession[]
}

// Per-user VPN session. Stores the user's real generated private/public key
// pair, the assigned VPN server, the assigned client IP, and the full .conf
// text. One active session per user.
model VPNSession {
  id            String   @id @default(cuid())
  userId        String
  serverId      String
  privateKey    String                     // client Curve25519 private key (base64)
  publicKey     String                     // client Curve25519 public key (base64)
  clientAddress String                     // e.g. 10.66.0.5/32
  config        String                     // full WireGuard .conf text
  status        String   @default("active") // active | disconnected | expired
  connectedAt   DateTime?
  disconnectedAt DateTime?
  lastVerifiedIp String?                   // last IP seen by the verify endpoint
  lastVerifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server        VPNServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ===== WebAuthn (Face ID / Fingerprint / Touch ID) =====
model WebAuthnCredential {
  id            String   @id           // base64url of credential ID
  userId        String
  publicKey     String                 // base64url-encoded public key
  counter       Int      @default(0)  // sign count for replay protection
  transports    String?               // JSON array: ["internal","hybrid",...]
  deviceType    String?               // "singleDevice" | "multiDevice"
  backedUp      Boolean  @default(false)
  name          String?               // user-assigned label (e.g. "MacBook Pro")
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== WebAuthn challenge storage (single-use, TTL = 5 min) =====
// Challenges MUST be stored server-side so the client cannot influence the
// expected challenge at verify time (defeats replay attacks). A challenge
// is created by the `options` endpoints (register/authenticate), persisted
// here with a 5-minute expiry, and marked `used = true` after verification
// (single-use). `userId` is null for the authenticate flow when the caller
// has not yet identified themselves (passkey discoverable login).
model WebauthnChallenge {
  id          String   @id @default(cuid())
  userId      String?  // null for authenticate (user not yet known)
  challenge   String   // the base64url challenge string
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@index([challenge])
}

// ===== Audit Log =====
// Security-sensitive action log. Append-only; written by the `audit()` helper
// in src/lib/audit.ts. Best-effort: failures never break the request.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  // user who performed the action (null = system/anonymous)
  action      String   // e.g. "user.login", "user.role_changed", "user.deleted", "customer.deleted", "2fa.disabled"
  targetType  String?  // e.g. "user", "customer", "post"
  targetId    String?  // ID of the affected resource
  metadata    String?  // JSON string with before/after values
  ip          String?  // request IP
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
