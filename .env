# Database URL
# Local development: PGlite (real PostgreSQL in WASM, no server needed)
# The createPgliteAdapter handles the actual connection.
# This URL is used by Prisma CLI for schema validation only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialflow

# To use Neon PostgreSQL instead, replace the above with your Neon connection string:
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/socialflow?sslmode=require
