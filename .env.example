# ============================================================================
# SYNQUE — Environment Variables Template (.env.example)
# ============================================================================
# Copy this file to `.env` and fill in your actual values.
# DO NOT commit the real `.env` file — it's in .gitignore.
#
# Generate secrets with: openssl rand -hex 32
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE — Neon PostgreSQL
# ----------------------------------------------------------------------------
# Get yours at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ----------------------------------------------------------------------------
# SECURITY — Generate with: openssl rand -hex 32
# ----------------------------------------------------------------------------
# JWT signing secret (required — app won't start without it)
JWT_SECRET=

# AES-256-GCM encryption key for secrets at rest (required — 64-char hex)
ENCRYPTION_KEY=

# Internal API key for scheduler → app publish route (required)
SCHEDULER_API_KEY=

# Vercel Cron Job secret — used by /api/cron/publish-scheduled to authenticate
# the server-to-server call from Vercel's scheduler (NOT a JWT). Vercel sends
# this as `Authorization: Bearer <CRON_SECRET>` on every cron invocation.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Shared-secret bearer token required by all mini-services (whatsapp-service,
# ai-service, zai-proxy, scheduler-service). The main app sends this as
# `Authorization: Bearer <MINI_SERVICE_KEY>` on every mini-service request
# except `/health`. Generate with: openssl rand -hex 32
MINI_SERVICE_KEY=

# ----------------------------------------------------------------------------
# DEMO MODE
# ----------------------------------------------------------------------------
# Set to "true" to enable the /api/auth/demo endpoint in production.
# When unset or "false", demo returns 403 in production.
ENABLE_DEMO=false

# ----------------------------------------------------------------------------
# MINI-SERVICES — Deploy each to Railway / Fly.io / similar
# ----------------------------------------------------------------------------
WHATSAPP_SERVICE_URL=https://your-whatsapp-service.up.railway.app
SCHEDULER_SERVICE_URL=https://your-scheduler-service.up.railway.app
AI_SERVICE_URL=https://your-ai-service.up.railway.app

# The scheduler service calls back to this URL to publish posts
APP_URL=https://your-domain.com

# ----------------------------------------------------------------------------
# AI PROVIDER — ZAI SDK (primary)
# ----------------------------------------------------------------------------
# Get yours from the ZAI dashboard
ZAI_API_KEY=
ZAI_BASE_URL=https://internal-api.z.ai/v1
ZAI_CHAT_ID=
ZAI_TOKEN=
ZAI_USER_ID=

# ----------------------------------------------------------------------------
# OPTIONAL AI PROVIDERS (fallback)
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ----------------------------------------------------------------------------
# STORAGE — Cloudinary
# ----------------------------------------------------------------------------
# Get yours at https://cloudinary.com
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=socialflow

# ----------------------------------------------------------------------------
# PORTS (for local dev — hosting platform sets these automatically)
# ----------------------------------------------------------------------------
# Main app: 3000
# WhatsApp service: 3002
# Scheduler service: 3003
# AI service: 3004

# ----------------------------------------------------------------------------
# STRIPE — Real card payment processing (P1-STRIPE)
# ----------------------------------------------------------------------------
# Get your test-mode keys from https://dashboard.stripe.com/test/apikeys
# and the webhook signing secret from
# https://dashboard.stripe.com/test/webhooks (endpoint = /api/stripe/webhook).
#
# STRIPE_SECRET_KEY          — server-only, used to create PaymentIntents +
#                              Checkout Sessions (sk_test_xxx in test mode).
# STRIPE_WEBHOOK_SECRET      — server-only, used to verify that incoming
#                              webhook events are genuinely from Stripe
#                              (whsec_xxx). NEVER expose this in the client.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY — safe to expose to the browser, used by
#                                      Stripe.js if you switch from Stripe
#                                      Checkout to embedded Elements.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

